---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Stagger main's direct children in. Pages that mark their own .rise items pass false. */
  stagger?: boolean;
}

const { title, description, image, stagger = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class:list={['container', { stagger }]} style="view-transition-name: page">
      <slot />
    </main>
    <Footer />
  </body>
</html>
