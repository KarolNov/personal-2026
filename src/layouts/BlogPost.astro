---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/posts';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { id, title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage?.src ?? `/og/${id}.png`} stagger={false}>
  <article>
    <header>
      <a class="back rise" href="/blog/"><span aria-hidden="true">←</span> All posts</a>
      <p class="muted meta rise">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <> · updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
      </p>
      <h1 class="rise" style="--i: 1">{title}</h1>
    </header>
    {heroImage && <Image class="rise" style="--i: 2" src={heroImage} alt="" width={1200} loading="eager" />}
    <div class="prose rise" style="--i: 2">
      <slot />
    </div>
  </article>
  <p class="rise" style="--i: 3"><a class="back" href="/blog/"><span aria-hidden="true">←</span> All posts</a></p>
</BaseLayout>

<style>
  /* Long posts get the way back at both ends, kept quiet so it doesn't compete with the title. */
  .back { font-size: 0.9rem; color: var(--muted); text-decoration: none; transition: color 150ms ease; }
  .back span { display: inline-block; transition: transform 150ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .back:hover { color: var(--fg); }
    .back:hover span { transform: translateX(-2px); }
  }
  header .back { display: inline-block; margin-bottom: 1.25rem; }
  .meta { margin: 0; font-size: 0.95rem; }
  header { margin-bottom: 2rem; }
  .prose { margin-bottom: 3rem; }
  .prose :global(h2) { margin-top: 2.5rem; }
  /* Inline code in running text. Code blocks and code inside components keep their own styling. */
  .prose :global(:is(p, li, td, th, h2, h3, h4, blockquote, a) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--code-border);
    border-radius: 6px;
    background: var(--code-bg);
    color: var(--code-fg);
    font-size: 0.85em;
    overflow-wrap: anywhere;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .prose :global(a > code) { color: inherit; }
  .prose :global(blockquote) {
    margin: 1.5rem 0; padding-left: 1rem; border-left: 3px solid var(--border); color: var(--muted);
  }
  /* Tables bleed past the text column like the playgrounds do. `separate` borders keep the
     rounded outline; cells draw only their bottom and left edges. */
  .prose > :global(table) {
    --w: min(50rem, 100vw - 2.5rem);
    width: var(--w);
    margin: 2.25rem calc((100% - var(--w)) / 2);
    border: 1px solid var(--border); border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
    border-collapse: separate; border-spacing: 0;
    font-size: 0.9rem; line-height: 1.45;
  }
  .prose > :global(table :is(th, td)) {
    padding: 0.55rem 0.8rem; text-align: left; vertical-align: top;
    border-bottom: 1px solid var(--border);
  }
  .prose > :global(table :is(th, td) + :is(th, td)) { border-left: 1px solid var(--border); }
  .prose > :global(table tbody tr:last-child > *) { border-bottom: 0; }
  .prose > :global(table thead th) { font-weight: 600; }
  .prose > :global(table tbody td:first-child) { font-weight: 500; }
  /* Markdown tables get no wrapper, so on phones the table itself becomes the scroll box. */
  @media (max-width: 40rem) {
    .prose > :global(table) { display: block; overflow-x: auto; }
  }
</style>
