---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes, essays and write-ups." stagger={false}>
  <h1 class="rise">Blog</h1>
  <p class="muted rise" style="--i: 1">Notes, essays and write-ups. Subscribe via <a href="/rss.xml">RSS</a>.</p>
  <PostList posts={posts} stagger={2} />
</BaseLayout>

<style>
  p { margin-bottom: 2.5rem; }
</style>
