---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import LiveContributionGraph from '../components/LiveContributionGraph.astro';
import { getContributions } from '../lib/contributions';
import { roles } from '../lib/roles';
import { GITHUB_LOGIN, GITHUB_URL, LINKEDIN_URL, TWITTER_HANDLE } from '../consts';

// The page is prerendered with the contribution graph as of the build; the live island
// (src/components/LiveContributionGraph.astro) swaps in current data after load.
const github = GITHUB_LOGIN;
const contributions = await getContributions(github);
---

<BaseLayout
  title="About"
  description="Principal software engineer building complex, user-centric web products."
>
  <h1>About</h1>
  <p class="lede">
    I'm a principal software engineer with multiple years of building complex, user-centric web products —
    from visual editors with real-time collaboration to AI tools and the infrastructure behind them. I care
    most about the space where engineering, user needs and product meet.
  </p>
  <p>
    Since 2020 I've been at <a href="https://www.ceros.com/">Ceros</a>, where I've moved between leading
    teams and working hands-on. Today I'm an individual contributor reporting to the CTO, working on the
    architecture of our next-generation editor and helping the teams building on it deliver their commitments.
    Before Ceros I spent two years at a software house and freelanced building websites and web apps.
  </p>

  <section>
    {/* The resume is the Work section as a PDF, so it's offered as that section's action, on the
        heading's line the way each role's dates sit on its title's. The PDF comes from /api/resume
        after a Turnstile check (src/scripts/resume-download.ts); without JavaScript the post has no
        token and the endpoint turns it away. */}
    <div class="section-head">
      <h2>Work</h2>
      <form class="resume-form" method="post" action="/api/resume">
        <button class="resume" type="submit">
          Download resume
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2.5v8m0 0L4.5 7M8 10.5 11.5 7M3 13.5h10" /></svg>
        </button>
      </form>
    </div>
    <span class="resume-check"></span>
    <p class="resume-status" role="status"></p>
    <div class="timeline">
      <ol class="roles">
        {roles.map((role) => (
          <li>
            <div class="role-head">
              <h3>{role.title} <span class="muted">· {role.project}</span></h3>
              <span class="muted when">{role.when}</span>
            </div>
            <ul class="points">
              {role.points.map((point) => <li>{point}</li>)}
            </ul>
            <ul class="tags" aria-label="Stack">
              {role.stack.map((tool) => <li>{tool}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
    <p class="more">More on what I built in each role, and my side projects, on <a href="/projects/">Projects</a>.</p>
  </section>

  <section>
    <h2>How I work</h2>
    <p>
      I've never loved code for its own sake — what I enjoy is shipping things people use and seeing the
      result. Long before AI tools I was the top committer on my teams, writing it all by hand. Today most of
      my code is written by agents — I spend my time on architecture, on reviewing what they produce and on
      deciding what's worth building. Those years of writing it by hand are why I can review their work
      properly and stand behind what ships.
    </p>
    {/* A stable wrapper for the ball to stop at: the island swaps the graph inside it. */}
    {/* Greys the graph out before it paints, for the scroll ball to wake (src/scripts/scroll-ball.ts). */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('graph-asleep');
    </script>
    <div class="graph">
      <LiveContributionGraph server:defer login={github}>
        {contributions && <ContributionGraph slot="fallback" calendar={contributions} login={github} />}
      </LiveContributionGraph>
    </div>
    <p>
      I like small teams with clear goals, and products shaped by evidence about their users.
    </p>
  </section>

  <section>
    <h2>Outside work</h2>
    <p>
      I'm based in Poland. Polish and Croatian are both native languages for me, alongside English and some
      Spanish. In 2026 I finished a bachelor's in economics at Kozminski University,
      studying at weekends alongside full-time work.
    </p>
    <p>
      Away from the keyboard you'll find me bouldering, out on a long run or a hike, cooking or listening to
      music. Most of all I like to travel — not just a long weekend away, but staying somewhere long enough to
      get to know it, and working from there for a few weeks.
    </p>
    <p>
      That's why I'm looking for a remote team. I've worked with people across time zones for years, and I
      know what makes it work: clear writing, decisions that don't wait for a meeting, and enough overlap to
      talk things through when it matters.
    </p>
  </section>

  <section>
    <h2>Elsewhere</h2>
    <p class="elsewhere">
      <a class="touch" href="/contact/">Get in touch</a>
      <span><span class="muted">or find me on</span> <a href={GITHUB_URL}>GitHub</a> · <a href={LINKEDIN_URL}>LinkedIn</a> · <a href={`https://x.com/${TWITTER_HANDLE.slice(1)}`}>X</a></span>
    </p>
  </section>

  <svg class="trail" aria-hidden="true">
    <defs>
      <linearGradient id="trail-fade" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="currentColor" stop-opacity="0" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0.45" />
      </linearGradient>
    </defs>
    <path class="track" />
    <path class="junctions" />
    <path class="trail-line" stroke="url(#trail-fade)" />
  </svg>
  <span class="ball" aria-hidden="true"></span>
</BaseLayout>

<style>
  .lede { font-size: 1.2rem; color: var(--muted); }
  section { margin-top: 4.5rem; }
  h2 { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  /* A red ball rides along as you scroll, driven by src/scripts/scroll-ball.ts. It runs down a
     rail in the left margin (stepping around the contribution graph where it reaches past) with a
     dot level with each stop. At the title or a heading it
     stretches across into an underline; reaching the contribution graph wakes it; at the end it
     fills in the "Get in touch" button. The rail and dots are drawn faintly, and a fading trail
     follows the ball. All of it sits behind the text. */
  :global(main) { position: relative; }
  /* Nothing should scroll the page sideways. */
  :global(body) { overflow-x: clip; }
  h1, h2 { width: fit-content; }
  .trail {
    /* Laid over main; the script draws the track in main's coordinates, and of the trail only
       the stretch the ball just covered. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: -1;
    pointer-events: none;
    animation: none;
    color: var(--accent-bg);
  }
  .trail path {
    fill: none;
    stroke-width: 0.3rem;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The track and a dot at each stop, quietly in the background. */
  .trail .track,
  .trail .junctions { stroke: var(--border); }
  .trail .track { stroke-width: 1.5px; }
  .trail .junctions { stroke-width: 7px; }
  .ball {
    position: absolute;
    top: 0;
    left: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--accent-bg);
    z-index: -1;
    pointer-events: none;
    /* Driven by the script, size included; opt out of the page entrance and start hidden until
       it's placed. */
    animation: none;
    visibility: hidden;
  }
  /* The margin the ball rides in sits in the page's side padding, so role text lines up with
     the rest of the page and the ball never crosses it. Wider screens have room for more. */
  .timeline { --gutter: 1.25rem; margin-left: calc(-1 * var(--gutter)); padding-left: var(--gutter); }
  @media (min-width: 48rem) { .timeline { --gutter: 1.75rem; } }
  .roles { list-style: none; padding: 0; margin: 0; display: grid; gap: 3.5rem; }
  .roles > li { transition: opacity 320ms var(--ease-out); }
  .roles.dim > li:not(.active) { opacity: 0.75; }
  .role-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 1rem; }
  h3 { font-size: 1.05rem; margin: 0; }
  h3 .muted { font-weight: 400; }
  .more { margin-top: 3rem; }
  .when { font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .points { margin: 1rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; }
  .tags { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* The button and the links wrap as two whole pieces, each on its own line on narrow screens,
     rather than leaving a stray link under the button. */
  .elsewhere { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .elsewhere > span { white-space: nowrap; }

  /* An outlined pill; the ball fills it in when it arrives (.lit). */
  .touch {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      background-color 200ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  /* The quieter pill beside it: a plain outline that warms to the accent on hover. */
  /* The heading and its action share a line, like a role's title and dates. */
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1rem; }
  /* A quiet text action: muted until it's wanted, so it doesn't compete with the heading. */
  .resume {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: color 150ms ease, transform 160ms var(--ease-out);
  }
  .resume svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: transform 150ms var(--ease-out); }
  .resume:active { transform: scale(0.97); }
  .resume[aria-busy='true'] { cursor: progress; }
  .resume[aria-busy='true'] svg { animation: nudge 700ms var(--ease-in-out) infinite alternate; }
  @keyframes nudge { to { transform: translateY(2px); } }
  @media (hover: hover) and (pointer: fine) {
    .resume:hover { color: var(--accent); }
    .resume:hover svg { transform: translateY(1px); }
  }
  /* Interaction-only Turnstile: empty unless Cloudflare wants a click, then the box appears under
     the heading. The status line only shows when something went wrong. */
  .resume-check { display: block; }
  .resume-check:not(:empty) { margin-bottom: 1rem; }
  .resume-status { margin: 0 0 1rem; font-size: 0.9rem; color: var(--danger); }
  .resume-status:empty { display: none; }
  .touch.lit { color: var(--accent-fg); border-color: var(--accent-bg); }
  .touch:active { transform: scale(0.97); }
  /* Hover only where there's a real pointer; on touch it would stick after a tap. */
  @media (hover: hover) and (pointer: fine) {
    .touch:hover { color: var(--accent-fg); border-color: var(--accent-bg); }
    .touch:hover:not(.lit) { background: var(--accent-bg); }
  }

  /* A year of days in the text column makes for tiny squares on a desktop, so where there's room the
     graph widens past the column on both sides, centred on it (up to 56rem, keeping 2rem clear of
     the screen edges). It never gets narrower than the column. */
  .graph {
    --wide: max(100%, min(56rem, 100vw - 4rem));
    width: var(--wide);
    margin-left: calc((100% - var(--wide)) / 2);
  }

  /* Reduced motion: no travel or trail. Underlines fade in at their heading (see the script). */
  @media (prefers-reduced-motion: reduce) {
    .roles > li { transition: none; }
    .resume[aria-busy='true'] svg { animation: none; }
  }
</style>

<script>
  import { initScrollBall } from '../scripts/scroll-ball';
  import { initResumeDownload } from '../scripts/resume-download';

  initScrollBall();
  initResumeDownload();
</script>
