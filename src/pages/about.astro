---
import BaseLayout from '../layouts/BaseLayout.astro';

const roles = [
  {
    title: 'Principal Software Engineer',
    when: '2025 – now',
    project: 'Ceros Flex',
    points: [
      'Led the move of our sync engine from two-way syncing to an intent-based operations pipeline: every change is validated, normalised and auto-fixed before it lands, so documents stay consistent across collaborators, offline edits and version history.',
      'Helped shape how the DOM tree lives in the CRDT, with fractional indexing so concurrent moves stay conflict-free and cheap to observe on the client.',
      'Built a way for customers to bring content made in Flex into their own sites and apps without relying on iframes.',
      'Worked on performance across the stack — for example, a few recent changes made our server-side and static rendering around 30% faster.',
    ],
    stack: ['Next.js', 'Y.js', 'WebSockets', 'NestJS', 'PostgreSQL', 'Terraform'],
  },
  {
    title: 'Lead Software Engineer',
    when: '2024 – 2025',
    project: 'Ceros Flex',
    points: [
      'Led a team of up to eight senior engineers rebuilding Ceros Studio — a client-heavy visual editor in the same family as Figma or Framer — and helped my reports grow into staff and lead roles.',
      'Set the frontend architecture: real-time collaboration with offline and version history (Y.js), an extensible visual HTML editor built on Web Components, and a DSL that can be edited both visually and as code, which made adding AI collaborators straightforward.',
      'Was part of a cross-team effort with QE and DevOps on our end-to-end pipeline: around 10,000 Playwright tests on custom AWS runners in 6–8 minutes on every PR.',
      'Helped reshape our engineering culture at Ceros, balancing quality, security and speed of delivery in the age of AI-assisted development.',
    ],
    stack: ['Lit / Web Components', 'Turborepo', 'Vite', 'Vitest', 'Playwright'],
  },
  {
    title: 'Senior Staff Software Engineer',
    when: '2024',
    project: 'AI assistant',
    points: [
      'Built an AI assistant that worked across Ceros products, with ideas that were early at the time: a voice-to-voice mode before realtime APIs were common, artifact-style outputs, and a visual guide that let vision models point at exact spots on an image.',
      'The project was sunset after a change in leadership and strategy, but what we learned building it carried into AI features across Ceros products.',
    ],
    stack: ['React', 'Python', 'FastAPI', 'LangChain', 'Temporal', 'Pinecone'],
  },
  {
    title: 'Senior, then Lead Software Engineer',
    when: '2020 – 2024',
    project: 'MarkUp.io',
    points: [
      'Joined early and spent four years on a product for commenting directly on live websites — which meant learning the limits of the web the hard way: proxying and shimming third-party sites into iframes, pins that stick to elements, and a Chrome extension for pages that refuse to be embedded.',
      'Built a native screenshot pipeline (snapshot, rebuild, headless browser) that beat any HTML-to-image library on consistency, and helped architect instant and digest notifications for email, Slack and Teams.',
      'Learned to build from customer evidence: analytics, customer learning sessions and a Slack community where you see the effect of a fix the same day.',
    ],
    stack: ['React', 'Express', 'BullMQ', 'AWS SQS', 'DynamoDB', 'Chrome extension'],
  },
];
---

<BaseLayout
  title="About"
  description="Principal software engineer building complex, user-centric web products."
>
  <h1>About</h1>
  <p class="lede">
    I'm a principal software engineer with multiple years of building complex, user-centric web products —
    from visual editors with real-time collaboration to AI tools and the infrastructure behind them. I care
    most about the space where engineering, user needs and product meet.
  </p>
  <p>
    Since 2020 I've been at <a href="https://www.ceros.com/">Ceros</a>, where I've moved between leading
    teams and working hands-on. Today I'm an individual contributor reporting to the CTO, working on the
    architecture of our next-generation editor and helping the teams building on it deliver their commitments.
    Before Ceros I spent two years at a software house and freelanced building websites and web apps.
  </p>

  <section>
    <h2>Work</h2>
    <div class="timeline">
      <ol class="roles">
        {roles.map((role) => (
          <li>
            <div class="role-head">
              <h3>{role.title} <span class="muted">· {role.project}</span></h3>
              <span class="muted when">{role.when}</span>
            </div>
            <ul class="points">
              {role.points.map((point) => <li>{point}</li>)}
            </ul>
            <ul class="tags" aria-label="Stack">
              {role.stack.map((tool) => <li>{tool}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <h2>How I work</h2>
    <p>
      I've never loved code for its own sake — what I enjoy is shipping things people use and seeing the
      result. Long before AI tools I was the top committer on my teams, writing it all by hand. Today most of
      my code is written by agents — I spend my time on architecture, on reviewing what they produce and on
      deciding what's worth building. Those years of writing it by hand are why I can review their work
      properly and stand behind what ships.
    </p>
    <p>
      I like small teams with clear goals, and products shaped by evidence about their users.
    </p>
  </section>

  <section>
    <h2>Outside work</h2>
    <p>
      I'm based in Poland. Polish and Croatian are both native languages for me, alongside English and some
      Spanish. In 2026 I finished a bachelor's in economics at Kozminski University,
      studying at weekends alongside full-time work. Away from the keyboard you'll find me bouldering, out on a
      long run or a hike, cooking, travelling or listening to music.
    </p>
  </section>

  <section>
    <h2>Elsewhere</h2>
    <p>
      <a class="touch" href="/contact/">Get in touch</a> <span class="muted">or find me on</span> <a href="https://github.com/KarolNov">GitHub</a> · <a href="https://www.linkedin.com/in/karol-nov/">LinkedIn</a>
    </p>
  </section>

  <canvas class="trail" aria-hidden="true"></canvas>
  <span class="ball" aria-hidden="true"></span>
</BaseLayout>

<style>
  .lede { font-size: 1.2rem; color: var(--muted); }
  section { margin-top: 4.5rem; }
  h2 { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  /* A red ball rides along as you scroll (see the script below). It starts as the underline
     under the page title, drops into the left margin, and at each role and section lands on the
     heading and stretches into an underline before dropping back into the margin. At the end it
     fills in the "Get in touch" button. A fading trail follows it. Both sit behind the text. */
  :global(main) { position: relative; }
  /* The bounce can overshoot the window edge; don't let that scroll the page sideways. */
  :global(body) { overflow-x: clip; }
  h1, h2 { width: fit-content; }
  .trail {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    animation: none;
  }
  .ball {
    position: absolute;
    top: 0;
    left: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--accent-bg);
    z-index: -1;
    pointer-events: none;
    /* Driven by the script; opt out of the page entrance and start hidden until it's placed. */
    animation: none;
    visibility: hidden;
  }
  /* The margin the ball rides in sits in the page's side padding, so role text lines up with
     the rest of the page and the ball never crosses it. Wider screens have room for more. */
  .timeline { --gutter: 1.25rem; margin-left: calc(-1 * var(--gutter)); padding-left: var(--gutter); }
  @media (min-width: 48rem) { .timeline { --gutter: 1.75rem; } }
  .roles { list-style: none; padding: 0; margin: 0; display: grid; gap: 3.5rem; }
  .roles > li { transition: opacity 320ms var(--ease-out); }
  .roles.dim > li:not(.active) { opacity: 0.75; }
  .role-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 1rem; }
  h3 { font-size: 1.05rem; margin: 0; }
  h3 .muted { font-weight: 400; }
  .when { font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .points { margin: 1rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; }
  .tags { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* An outlined pill; the ball fills it in when it arrives (.lit). */
  .touch {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      background-color 200ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .touch.lit { color: var(--accent-fg); border-color: var(--accent-bg); }
  .touch:active { transform: scale(0.97); }
  /* Hover only where there's a real pointer; on touch it would stick after a tap. */
  @media (hover: hover) and (pointer: fine) {
    .touch:hover { color: var(--accent-fg); border-color: var(--accent-bg); }
    .touch:hover:not(.lit) { background: var(--accent-bg); }
  }

  /* Gentle snapping to each role, only where a role fits on screen. */
  @media (min-width: 48rem) and (prefers-reduced-motion: no-preference) {
    :global(html) { scroll-snap-type: y proximity; }
    .roles > li { scroll-snap-align: start; scroll-margin-top: 2rem; }
  }

  /* Reduced motion: no travel or trail. Underlines fade in at their heading (see the script). */
  @media (prefers-reduced-motion: reduce) {
    .roles > li { transition: none; }
    .ball { transition: opacity 150ms var(--ease-out); }
  }
</style>

<script>
  const ball = document.querySelector<HTMLElement>('.ball');
  const canvas = document.querySelector<HTMLCanvasElement>('.trail');
  const main = ball?.parentElement;
  const title = document.querySelector<HTMLElement>('main h1');
  const timeline = document.querySelector<HTMLElement>('.timeline');
  const list = timeline?.querySelector<HTMLElement>('.roles');
  const touch = document.querySelector<HTMLElement>('.touch');
  const ctx = canvas?.getContext('2d');

  if (ball && canvas && ctx && main && title && timeline && list && touch) {
    const roles = [...list.querySelectorAll<HTMLElement>(':scope > li')];
    // Where the ball stops after the title, in order: each role's heading, each later section's
    // heading, and finally the "Get in touch" button. A stop's zone is the stretch of page it
    // belongs to; the ball arrives as the zone reaches the reading line.
    const stops = [
      ...roles.map((role) => ({ el: role.querySelector<HTMLElement>('.role-head')!, zone: role })),
      ...[...main.querySelectorAll<HTMLElement>('section h2')]
        .filter((h2) => !h2.closest('section')!.contains(timeline) && !h2.closest('section')!.contains(touch))
        .map((h2) => ({ el: h2, zone: h2.closest('section')! })),
      { el: touch, zone: touch },
    ];
    const dot = ball.offsetWidth;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const TRAIL_MS = 550;

    type Box = { x: number; y: number; w: number; h: number };
    const KEYS = ['x', 'y', 'w', 'h'] as const;
    const clamp = (v: number, min: number, max: number) => Math.min(Math.max(v, min), max);

    // Layout boxes in main's coordinates, which the ball is positioned in. Built from offsets, not
    // getBoundingClientRect, so the page's entrance animation (which shifts content while it
    // runs) doesn't throw the measurements off.
    function box(el: HTMLElement) {
      let top = 0;
      let left = 0;
      for (let node: HTMLElement | null = el; node && node !== main; node = node.offsetParent as HTMLElement | null) {
        top += node.offsetTop;
        left += node.offsetLeft;
      }
      return { top, left, width: el.offsetWidth, height: el.offsetHeight };
    }

    // The ball follows a reading line, in main's coordinates, normally 40% down the viewport.
    // At the top it starts just under the title, and towards the bottom it speeds up to reach the
    // "Get in touch" button, which would otherwise never get that far up the screen. Both ramps
    // keep the ball moving continuously instead of jumping.
    function readingLine() {
      const middle = innerHeight * 0.4;
      // Page positions (where they'd be in the viewport at scroll 0).
      const mainTop = main!.getBoundingClientRect().top + scrollY;
      const top = mainTop + box(title!).top + box(title!).height + 4;
      const maxScroll = document.documentElement.scrollHeight - innerHeight;
      const bottom = mainTop + box(touch!).top + box(touch!).height - maxScroll;
      let line = middle;
      if (middle > top) line = top + (middle - top) * clamp(scrollY / (middle - top), 0, 1);
      if (bottom > middle) line += (bottom - line) * clamp(1 - (maxScroll - scrollY) / (bottom - middle), 0, 1);
      return line - main!.getBoundingClientRect().top;
    }

    // The ball's track hugs the outer edge of the left margin, well clear of the text.
    const trackX = () => box(timeline!).left + 2;

    // Where the ball should end up for the current scroll position, and the stop it's
    // stretched over there, if any.
    function target(): { box: Box; line: HTMLElement | null } {
      // Headings get an underline; the button gets filled in.
      const shape = (el: HTMLElement) => {
        const b = box(el);
        return el === touch
          ? { box: { x: b.left, y: b.top, w: b.width, h: b.height }, line: el }
          : { box: { x: b.left, y: b.top + b.height + 3, w: b.width, h: dot * 0.6 }, line: el };
      };
      const centre = (el: HTMLElement) => {
        const { box: b } = shape(el);
        return b.y + b.h / 2;
      };

      // At the top of the page the ball underlines the title.
      if (scrollY < 16) return shape(title!);

      const y = readingLine();
      // A stop starts a little before its zone reaches the reading line, and holds for the first
      // part of the zone — at least 140px of scrolling even for short sections — so a quick scroll
      // still gives the ball time to get there. The last stop holds for good.
      const land = (i: number) => box(stops[i].zone).top - 48;
      const hold = (i: number) => {
        const zone = box(stops[i].zone);
        return i === stops.length - 1 ? Infinity : zone.top + clamp(zone.height * 0.45, 140, 220);
      };
      const index = stops.findLastIndex((_, i) => land(i) <= y);
      if (index >= 0 && y < hold(index)) return shape(stops[index].el);

      // Otherwise ride down the track to the next stop. The ride is paced so the ball reaches the
      // next stop just as its zone reaches the reading line: it makes up the time it spent holding
      // evenly along the way, never with a sudden dash.
      const head = box(title!);
      const from = index < 0
        ? { y: centre(title!), at: head.top + head.height + 4 }
        : { y: centre(stops[index].el), at: hold(index) };
      const next = stops[index + 1];
      const t = clamp((y - from.at) / (land(index + 1) - from.at), 0, 1);
      const at = from.y + (centre(next.el) - from.y) * t;
      return { box: { x: trackX(), y: at - dot / 2, w: dot, h: dot }, line: null };
    }

    // A spring per property. Position is critically damped — a smooth ease-out with no overshoot,
    // so the ball and its trail don't sway. Size keeps a little bounce when stretching into an
    // underline, but retracts crisply with none, so the ball never dips to nothing on the way back.
    const SPRING = {
      x: { stiffness: 200, damping: 28 },
      y: { stiffness: 200, damping: 28 },
      w: { stiffness: 220, damping: 20 },
      h: { stiffness: 220, damping: 20 },
    };
    const RETRACT = { stiffness: 300, damping: 35 };
    let { box: goal, line: goalLine } = target();
    const pos: Box = { ...goal };
    const vel: Box = { x: 0, y: 0, w: 0, h: 0 };
    // The heading the ball is currently stretched under, and that underline's box.
    let line = goalLine;
    let lineBox = goal;
    let last = 0;
    let frame = 0;
    // Recent positions of the ball's leading end, in main's coordinates.
    let trail: { x: number; y: number; t: number }[] = [];

    function render() {
      // Squash and stretch along the direction of travel while it's a ball.
      const speed = Math.hypot(vel.x, vel.y);
      const stretch = pos.w < dot * 2 ? clamp(speed / 6000, 0, 0.12) : 0;
      const angle = Math.atan2(vel.y, vel.x);
      touch!.classList.toggle('lit', line === touch && pos.w > dot * 2);
      ball!.style.width = `${pos.w}px`;
      ball!.style.height = `${pos.h}px`;
      ball!.style.transform =
        `translate(${pos.x}px, ${pos.y}px) rotate(${angle}rad) scale(${1 + stretch}, ${1 - stretch}) rotate(${-angle}rad)`;
    }

    function drawTrail(now: number) {
      trail = trail.filter((p) => now - p.t < TRAIL_MS);
      const dpr = devicePixelRatio || 1;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, innerWidth, innerHeight);
      if (trail.length < 2) return;
      // Trail points live in main's coordinates so they stay put on the page as it scrolls.
      const m = main!.getBoundingClientRect();
      ctx!.strokeStyle = getComputedStyle(ball!).backgroundColor;
      ctx!.lineCap = 'round';
      for (let i = 1; i < trail.length; i++) {
        const life = 1 - (now - trail[i].t) / TRAIL_MS;
        ctx!.globalAlpha = life * life * 0.6;
        ctx!.lineWidth = dot * (0.25 + 0.6 * life);
        ctx!.beginPath();
        ctx!.moveTo(trail[i - 1].x + m.left, trail[i - 1].y + m.top);
        ctx!.lineTo(trail[i].x + m.left, trail[i].y + m.top);
        ctx!.stroke();
      }
    }

    // A ball on the track, level with an underline.
    const ballAt = (b: Box): Box => ({ x: trackX(), y: b.y + b.h / 2 - dot / 2, w: dot, h: dot });

    // Shape changes happen before travelling, never during: an underline first shrinks sideways
    // into a ball on the track, then the ball moves; a ball first gets level with its heading on
    // the track, then stretches out under it. So the ball only ever travels along the track.
    // The ball lands on a stop when you settle on it, not while you fly past. A stop reached while
    // scrolling slowly — or where scrolling comes to rest — is committed: the ball gets there and
    // stretches out even if you then drift past, and the underline lingers a moment before moving
    // on. A fast scroll cancels any landing still on its way, so the ball rides along with you
    // and never lags behind replaying stops you've already left.
    const LINGER_MS = 200;
    const FAST_PX_PER_S = 1500;
    let landedAt = 0;
    let pending: { el: HTMLElement; box: Box } | null = null;
    let speed = 0;
    let lastScroll = { y: scrollY, t: performance.now() };
    let restTimer = 0;

    const next = () => pending;

    function stage(now: number): Box {
      if (line) {
        if (line === goalLine) return goal;
        return now - landedAt < LINGER_MS ? lineBox : ballAt(lineBox);
      }
      const stop = next();
      return stop ? ballAt(stop.box) : goal;
    }

    function step(now: number) {
      frame = 0;
      const dt = Math.min((now - (last || now)) / 1000, 1 / 30);
      last = now;
      // Settled on a stop the ball isn't on yet (e.g. it was busy with the previous one): head there.
      if (!pending && goalLine && goalLine !== line && speed <= FAST_PX_PER_S) pending = { el: goalLine, box: goal };
      const aim = stage(now);
      let moving = false;
      for (const k of KEYS) {
        const spring = (k === 'w' || k === 'h') && aim[k] < pos[k] ? RETRACT : SPRING[k];
        const force = spring.stiffness * (aim[k] - pos[k]) - spring.damping * vel[k];
        vel[k] += force * dt;
        pos[k] += vel[k] * dt;
        if (Math.abs(aim[k] - pos[k]) > 0.1 || Math.abs(vel[k]) > 0.1) moving = true;
        else { pos[k] = aim[k]; vel[k] = 0; }
      }

      // Move on to the next stage once this one is (nearly) done.
      if (line && line !== goalLine) {
        if (now - landedAt < LINGER_MS) moving = true;
        else if (Math.abs(pos.w - dot) < 1 && Math.abs(pos.h - dot) < 1) {
          line = null;
          moving = true;
        }
      } else if (!line && next() && Math.hypot(pos.x - aim.x, pos.y - aim.y) < 4 && Math.hypot(vel.x, vel.y) < 400) {
        // Close enough, and not still flying past: start stretching.
        const stop = next()!;
        line = stop.el;
        lineBox = stop.el === goalLine ? goal : stop.box;
        landedAt = now;
        pending = null;
        moving = true;
      }
      render();

      const lead = { x: pos.x + Math.min(pos.w, dot) / 2, y: pos.y + pos.h / 2, t: now };
      const prev = trail.at(-1);
      if (!prev || Math.hypot(lead.x - prev.x, lead.y - prev.y) > 0.5) trail.push(lead);
      drawTrail(now);

      // Keep going while the ball moves or its trail is still fading.
      if (moving || trail.length > 1) frame = requestAnimationFrame(step);
      else last = 0;
    }

    function update() {
      ({ box: goal, line: goalLine } = target());
      if (line && line === goalLine) lineBox = goal;
      if (goalLine && goalLine === line) pending = null;
      else if (speed > FAST_PX_PER_S) {
        if (!line) pending = null;
      } else if (goalLine && !pending) pending = { el: goalLine, box: goal };
      const y = readingLine();
      const active = roles.findLastIndex((role) => box(role).top <= y);
      roles.forEach((role, i) => role.classList.toggle('active', i === active));
      list!.classList.toggle('dim', scrollY >= 16 && active >= 0 && y <= box(timeline!).top + box(timeline!).height);
      if (reduceMotion.matches) {
        showStill();
      } else if (!frame) {
        frame = requestAnimationFrame(step);
      }
    }

    function resize() {
      const dpr = devicePixelRatio || 1;
      canvas!.width = innerWidth * dpr;
      canvas!.height = innerHeight * dpr;
      update();
    }

    // Place the ball without animating, e.g. once the web font has loaded and moved things.
    function place() {
      ({ box: goal, line: goalLine } = target());
      if (reduceMotion.matches) return showStill();
      Object.assign(pos, goal);
      Object.assign(vel, { x: 0, y: 0, w: 0, h: 0 });
      line = goalLine;
      lineBox = goal;
      pending = null;
      render();
    }

    // Reduced motion: only show underlines, fading each in where it is; hide the ball in between.
    function showStill() {
      const changed = goalLine !== line;
      Object.assign(pos, goal);
      Object.assign(vel, { x: 0, y: 0, w: 0, h: 0 });
      line = goalLine;
      lineBox = goal;
      pending = null;
      render();
      ball!.style.opacity = line ? '1' : '0';
      if (line && changed) ball!.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 150, easing: 'ease-out' });
    }

    render();
    ball.style.visibility = 'visible';
    document.fonts.ready.then(place);
    // Track scroll speed, and treat a short pause as coming to rest.
    function onScroll() {
      const now = performance.now();
      const instant = (Math.abs(scrollY - lastScroll.y) / Math.max(now - lastScroll.t, 1)) * 1000;
      speed = speed * 0.6 + instant * 0.4;
      lastScroll = { y: scrollY, t: now };
      clearTimeout(restTimer);
      restTimer = window.setTimeout(() => {
        speed = 0;
        update();
      }, 120);
      update();
    }

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', resize);
    new ResizeObserver(update).observe(main);
    resize();
  }
</script>
