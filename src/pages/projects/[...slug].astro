---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, projectUrl, type Project } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props as { project: Project; next: Project };
const { title, summary, role, when, status, stack, links, cover } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary} image={cover?.src} stagger={false}>
  <article>
    <header>
      <a class="back rise" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
      <p class="muted kicker rise">{project.data.kind === 'work' ? 'Work' : 'Side project'} · {status}</p>
      <h1 class="rise" style="--i: 1">{title}</h1>
      <p class="lede rise" style="--i: 1">{summary}</p>

      <dl class="facts rise" style="--i: 2">
        {role && (<div><dt>Role</dt><dd>{role}</dd></div>)}
        <div><dt>When</dt><dd>{when}</dd></div>
        <div class="stack">
          <dt>Stack</dt>
          <dd>
            <ul class="tags">{stack.map((tool) => <li>{tool}</li>)}</ul>
          </dd>
        </div>
      </dl>

      {links.length > 0 && (
        <ul class="links rise" style="--i: 2" aria-label="Links">
          {links.map((link, n) => (
            <li>
              <a class:list={['link', { primary: n === 0 }]} href={link.href} {...(link.href.startsWith('http') ? { rel: 'noopener' } : {})}>
                {link.label} <span aria-hidden="true">{link.href.startsWith('/') ? '→' : '↗'}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose rise" style="--i: 3">
      <Content />
    </div>
  </article>

  <nav class="foot rise" style="--i: 4" aria-label="More projects">
    <a class="back" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
    {next.id !== project.id && (
      <a class="next" href={projectUrl(next)}><span class="muted">Next:</span> {next.data.title} <span aria-hidden="true">→</span></a>
    )}
  </nav>
</BaseLayout>

<style>
  .back, .next { font-size: 0.9rem; color: var(--muted); text-decoration: none; transition: color 150ms ease; }
  .back span, .next > span:last-child { display: inline-block; transition: transform 150ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .back:hover, .next:hover { color: var(--fg); }
    .back:hover span { transform: translateX(-2px); }
    .next:hover > span:last-child { transform: translateX(2px); }
  }
  header .back { display: inline-block; margin-bottom: 1.25rem; }
  header { margin-bottom: 2.5rem; }
  .kicker { margin: 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .lede { font-size: 1.2rem; color: var(--muted); margin: 0.25rem 0 0; }

  .facts { display: grid; gap: 0.5rem; margin: 1.75rem 0 0; padding: 1rem 0; border-block: 1px solid var(--border); }
  .facts > div { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; align-items: baseline; }
  dt { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  dd { margin: 0; font-size: 0.95rem; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li { padding: 0.1rem 0.55rem; border: 1px solid var(--border); border-radius: 999px; font-size: 0.8rem; color: var(--muted); }

  .links { list-style: none; padding: 0; margin: 1.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .link {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 200ms var(--ease-out), background-color 200ms var(--ease-out), transform 160ms var(--ease-out);
  }
  .link.primary { border-color: var(--accent-bg); background: var(--accent-bg); color: var(--accent-fg); }
  .link:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .link:not(.primary):hover { border-color: var(--accent); }
    .link.primary:hover { filter: brightness(1.08); }
  }

  .prose { margin-bottom: 3rem; }
  .prose :global(h2) { margin-top: 2.5rem; font-size: 1.35rem; }
  .prose :global(:is(p, li) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--code-border);
    border-radius: 6px;
    background: var(--code-bg);
    color: var(--code-fg);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  .prose :global(li + li) { margin-top: 0.35rem; }

  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
</style>
