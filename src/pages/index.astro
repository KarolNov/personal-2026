---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>Hi, I'm Karol.</h1>
    <p class="lede">
      I build software and write about what I learn along the way. This is my corner of the web —
      notes, projects and the occasional long read.
    </p>
    <div class="cta">
      <a class="button" href="/blog/">Read the blog</a>
      <a class="button secondary" href="/contact/">Get in touch</a>
    </div>
  </section>

  <section>
    <h2>Recent writing</h2>
    <PostList posts={recent} />
  </section>
</BaseLayout>

<style>
  .hero { margin-bottom: 4rem; }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 36rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  h2 { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
</style>
