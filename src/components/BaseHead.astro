---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Hold the first render until the page is parsed, so pagereveal can find list links. -->
<link rel="expect" href="#site-footer" blocking="render" />
<script is:inline>
  // Apply a stored theme override before first paint (see ThemeToggle).
  try {
    const theme = localStorage.getItem('theme');
    if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
  } catch {}

  // A post's title in a list and its heading on the post page share a view-transition-name,
  // but list links only get it for navigations to or from that post. Naming them always would
  // also morph titles between the home and blog lists, flying them across the page.
  function nameLinkTo(url, transition) {
    if (!url || !transition) return;
    const link = document.querySelector(`a[data-vt-name][href="${new URL(url).pathname}"]`);
    if (!link) return;
    link.style.viewTransitionName = link.dataset.vtName;
    transition.finished.finally(() => (link.style.viewTransitionName = ''));
  }
  addEventListener('pageswap', (e) => nameLinkTo(e.activation?.entry?.url, e.viewTransition));
  addEventListener('pagereveal', (e) => nameLinkTo(window.navigation?.activation?.from?.url, e.viewTransition));
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image, Astro.url)} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
