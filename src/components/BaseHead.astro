---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
}

// Share card for pages without their own image. Without one, link previews fall back to scraping
// the small home-page portrait and blow it up.
const DEFAULT_IMAGE = '/og.png';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = DEFAULT_IMAGE } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Hold the first render until the page is parsed, so pagereveal can find list links. -->
<link rel="expect" href="#site-footer" blocking="render" />
<script is:inline>
  // Apply a stored theme override before first paint (see ThemeToggle).
  try {
    const theme = localStorage.getItem('theme');
    if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
  } catch {}

  // List ↔ post navigations slide sideways instead of fading (see global.css). Direction comes
  // from the URLs, so history back/forward slides the same way as clicking.
  addEventListener('pagereveal', (e) => {
    const root = document.documentElement;
    delete root.dataset.nav;
    const from = e.viewTransition && window.navigation?.activation?.from?.url;
    if (!from) return;
    const isPost = (path) => /^\/blog\/[^/]+\/?$/.test(path);
    const isList = (path) => path === '/' || path === '/blog/';
    const prev = new URL(from).pathname;
    if (isList(prev) && isPost(location.pathname)) root.dataset.nav = 'forward';
    else if (isPost(prev) && isList(location.pathname)) root.dataset.nav = 'back';
  });
</script>
<Font cssVariable="--font-geist" preload />
<Font cssVariable="--font-geist-mono" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta name="twitter:card" content="summary_large_image" />
