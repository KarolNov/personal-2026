---
// Follows the OS until clicked, then flips between light and dark and remembers the choice.
// The stored choice is applied before first paint by the inline script in BaseHead.
---

<button class="theme-toggle" type="button" aria-label="Switch theme">
  <svg class="icon light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg class="icon dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
</button>

<script>
  type Theme = 'light' | 'dark';
  const root = document.documentElement;
  const prefersDark = matchMedia('(prefers-color-scheme: dark)');
  // The theme on screen: a stored choice, or the OS one until there is a choice. Tracked here rather than read back
  // from the DOM: during a transition the DOM updates late.
  let pinned = (root.dataset.theme as Theme | undefined) ?? null;
  const shown = (): Theme => pinned ?? (prefersDark.matches ? 'dark' : 'light');
  let latest: ViewTransition | undefined;

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
  }

  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
  function sync(button: HTMLButtonElement) {
    const theme = shown();
    button.dataset.state = theme;
    button.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
  }
  // Until someone picks, the icon follows the OS as it changes.
  prefersDark.addEventListener('change', () => pinned === null && buttons.forEach(sync));

  for (const button of buttons) {
    sync(button);
    button.addEventListener('click', () => {
      const next: Theme = shown() === 'dark' ? 'light' : 'dark';
      pinned = next;
      buttons.forEach(sync);
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || reduceMotion) {
        apply(next);
        return;
      }

      // Reveal the new theme as a circle growing out of the button.
      const rect = button.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;

      root.classList.add('theme-transition');
      const transition = (latest = document.startViewTransition(() => apply(next)));
      transition.ready.then(() => {
        // The snapshot also covers the area behind mobile toolbars, which innerHeight leaves
        // out, so size the circle in %: 142% of the box's normalised diagonal (diagonal / √2)
        // is its full diagonal, enough to reach the farthest corner from any point.
        // easeOutQuad answers the click quickly without the long tail that made the last
        // corner of a tall screen crawl.
        root.animate(
          { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(142% at ${x}px ${y}px)`] },
          { duration: 550, easing: 'cubic-bezier(0.5, 1, 0.89, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
      // A rapid second click skips this transition; leave the class for the newer one.
      transition.finished.finally(() => latest === transition && root.classList.remove('theme-transition'));
    });
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .theme-toggle:hover { color: var(--fg); }
  .theme-toggle:active { transform: scale(0.95); }
  /* Both icons share one cell; the swap blurs one into the other rather than snapping. */
  .icon {
    grid-area: 1 / 1;
    opacity: 0;
    transform: scale(0.8);
    filter: blur(2px);
    transition: opacity 150ms var(--ease-out), transform 150ms var(--ease-out), filter 150ms var(--ease-out);
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon.dark { fill: currentColor; stroke: none; }
  /* Before the script runs, show the theme on screen straight from CSS. */
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme])) .theme-toggle:not([data-state]) .light { opacity: 1; transform: none; filter: none; } }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme])) .theme-toggle:not([data-state]) .dark { opacity: 1; transform: none; filter: none; } }
  :global(:root[data-theme='light']) .theme-toggle:not([data-state]) .light,
  :global(:root[data-theme='dark']) .theme-toggle:not([data-state]) .dark,
  .theme-toggle[data-state='light'] .light,
  .theme-toggle[data-state='dark'] .dark { opacity: 1; transform: none; filter: none; }
  /* Less motion: the icons still crossfade, without the scale and blur. */
  @media (prefers-reduced-motion: reduce) {
    .icon { transform: none; filter: none; }
  }
</style>
