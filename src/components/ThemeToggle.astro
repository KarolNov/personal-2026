---
// Cycles system → light → dark. "system" clears the override so the OS preference wins.
// The stored choice is applied before first paint by the inline script in BaseHead.
---

<button class="theme-toggle" type="button" aria-label="Theme: system">
  <svg class="icon system" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" /></svg>
  <svg class="icon light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg class="icon dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
</button>

<script>
  type Theme = 'system' | 'light' | 'dark';
  const ORDER: Theme[] = ['system', 'light', 'dark'];
  const root = document.documentElement;
  // Tracked here rather than read back from the DOM: during a transition the DOM updates late.
  let current: Theme = (root.dataset.theme as Theme | undefined) ?? 'system';
  let latest: ViewTransition | undefined;

  function apply(theme: Theme) {
    if (theme === 'system') delete root.dataset.theme;
    else root.dataset.theme = theme;
    try {
      if (theme === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', theme);
    } catch {}
  }

  function sync(button: HTMLButtonElement) {
    button.dataset.state = current;
    button.setAttribute('aria-label', `Theme: ${current}`);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    sync(button);
    button.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      current = next;
      sync(button);
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || reduceMotion) {
        apply(next);
        return;
      }

      // Reveal the new theme as a circle growing out of the button.
      const rect = button.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

      root.classList.add('theme-transition');
      const transition = (latest = document.startViewTransition(() => apply(next)));
      transition.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 750, easing: 'cubic-bezier(0.32, 0.72, 0, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
      // A rapid second click skips this transition; leave the class for the newer one.
      transition.finished.finally(() => latest === transition && root.classList.remove('theme-transition'));
    });
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--fg); }
  .icon {
    display: none;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon.dark { fill: currentColor; stroke: none; }
  .theme-toggle:not([data-state]) .system,
  .theme-toggle[data-state='system'] .system,
  .theme-toggle[data-state='light'] .light,
  .theme-toggle[data-state='dark'] .dark { display: block; }
</style>
