---
// Two clients and a server sharing the clip from <ClipPlayground>, across a schema change: v1 stores
// `in`/`out`, v2 stores `start`/`length`. Deploying v2 migrates the server and moves Bob onto the
// new build; Alice keeps her old tab. The rules live in ./migration-engine.ts; this is the stage,
// and it shares its look with <ClipPlayground>.
import { TRACK } from './clip-engine';
import type { Mode } from './migration-engine';

interface Props {
  mode: Mode;
  title?: string;
}

const TITLES: Record<Mode, string> = {
  reload: 'Migrate once, reload old clients',
  bridge: 'Migrate once, bridge old clients',
};
const PEERS = [
  { id: 'alice', name: 'Alice' },
  { id: 'bob', name: 'Bob' },
];
const NUDGES = [
  { kind: 'move', by: -1, label: '← move' },
  { kind: 'move', by: 1, label: 'move →' },
  { kind: 'trimEnd', by: -1, label: 'end −1s' },
  { kind: 'trimEnd', by: 1, label: 'end +1s' },
];
const { mode, title = TITLES[mode] } = Astro.props;
const LABELS = Array.from({ length: TRACK / 5 + 1 }, (_, i) => i * 5);
---

<figure class="mig" data-migration={mode}>
  <div class="bar">
    <span class="title">{title}</span>
    <div class="actions">
      <button type="button" data-deploy>Deploy v2</button>
      <button type="button" data-play>▶ Deploy, then move + trim</button>
      <button type="button" data-reset>Reset</button>
    </div>
  </div>

  <div class="stage">
    <svg class="wires" aria-hidden="true">
      {PEERS.map((p) => <path data-wire={p.id} />)}
    </svg>
    {mode === 'bridge' && (
      <div class="bridge" data-bridge-box hidden aria-hidden="true">
        <span class="bridge-title" data-bridge-title>bridge</span>
        <span class="bridge-map">v1 ⇄ v2</span>
      </div>
    )}
    {PEERS.map((p) => (
      <div class="peer" data-peer={p.id}>
        <div class="peer-head">
          <span class="name"><span class="swatch" />{p.name}<span class="ver" data-ver>v1</span></span>
          <label class="toggle">
            <input type="checkbox" checked data-online />
            <span>online</span>
          </label>
        </div>
        <div class="timeline" data-timeline>
          <div class="clip" data-clip><span class="len" data-len /></div>
          <span class="unreadable" data-unreadable hidden>can't read this clip</span>
        </div>
        <div class="scale" aria-hidden="true">{LABELS.map((s) => <span>{s}s</span>)}</div>
        <div class="nudges">
          {NUDGES.map((n) => (
            <button type="button" data-kind={n.kind} data-by={n.by}>{n.label}</button>
          ))}
        </div>
        <div class="fields" data-fields />
        <div class="outdated" data-outdated hidden>
          <span data-outdated-text>A new version is out.</span>
          <button type="button" data-reload>Reload</button>
        </div>
        <span class="queued" data-queued hidden />
      </div>
    ))}
    <div class="server">
      <div class="peer-head">
        <span class="name">Server<span class="ver" data-ver>v1</span></span>
        <span class="muted note" data-note>stores + relays</span>
      </div>
      <div class="timeline readonly" data-timeline>
        <div class="clip" data-clip><span class="len" data-len /></div>
        <span class="unreadable" data-unreadable hidden>can't read this clip</span>
      </div>
      <div class="fields" data-fields />
      <ol class="log" data-log aria-live="polite" />
    </div>
  </div>

  <div class="foot">
    <label class="latency">
      <span>Latency</span>
      <input type="range" min="200" max="3000" step="100" value="1200" data-latency />
      <output data-latency-out>1.2s</output>
    </label>
    {mode === 'bridge' && (
      <label class="toggle">
        <input type="checkbox" checked data-bridge />
        <span>translate for v1</span>
      </label>
    )}
    <span class="status" data-status>In sync</span>
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .mig {
    --alice: var(--accent);
    --bob: light-dark(#2459d6, #7aa7ff);
    --line: light-dark(#d9d3ca, #3a3132);
    --w: min(50rem, 100vw - 2.5rem);
    width: var(--w);
    margin: 2.25rem calc((100% - var(--w)) / 2);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
    font-size: 0.92rem;
    overflow: hidden;
  }

  .bar, .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.7rem 1rem;
  }
  .bar { justify-content: space-between; border-bottom: 1px solid var(--border); }
  .foot { border-top: 1px solid var(--border); color: var(--muted); }
  .title { font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
    transition: transform 120ms var(--ease-out), background-color 120ms;
  }
  button:hover { background: var(--border); }
  button:active { transform: scale(0.96); }
  button:disabled { opacity: 0.5; cursor: default; transform: none; }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'alice bob' 'server server';
    gap: 7.5rem 1rem;
    padding: 1.25rem 1rem;
  }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .wires path { fill: none; stroke: var(--line); stroke-width: 1.5; transition: opacity 250ms; }
  .wires path.offline { stroke-dasharray: 4 6; opacity: 0.7; }

  .peer, .server {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: 0.6rem 0.7rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    transition: border-color 300ms, box-shadow 300ms;
  }
  .peer[data-peer='alice'] { grid-area: alice; --who: var(--alice); }
  .peer[data-peer='bob'] { grid-area: bob; --who: var(--bob); }
  .server { grid-area: server; justify-self: center; width: min(100%, 26rem); --who: var(--muted); }
  .peer.offline { opacity: 0.85; border-style: dashed; }
  .flash { box-shadow: 0 0 0 3px color-mix(in srgb, var(--flash) 18%, transparent); border-color: color-mix(in srgb, var(--flash) 60%, var(--border)); }

  .peer-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; font-size: 0.85rem; }
  .name { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; }
  .swatch { width: 0.6rem; height: 0.6rem; border-radius: 99px; background: var(--who); }
  .note { font-size: 0.8rem; }
  .ver {
    padding: 0 0.35rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    font: 500 0.7rem/1.5 var(--font-mono);
    color: var(--muted);
  }
  .ver.new { color: var(--fg); border-color: var(--fg); }

  .toggle { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--muted); cursor: pointer; }
  .toggle input { accent-color: var(--accent); margin: 0; }

  .timeline {
    position: relative;
    height: 2.4rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background:
      repeating-linear-gradient(to right, color-mix(in srgb, var(--fg) 14%, transparent) 0 1px, transparent 1px calc(25% - 0.01px)),
      repeating-linear-gradient(to right, color-mix(in srgb, var(--fg) 6%, transparent) 0 1px, transparent 1px calc(5% - 0.01px)),
      var(--surface);
    transition: border-color 250ms;
  }
  .timeline.broken { border-color: var(--danger); }
  .scale { display: flex; justify-content: space-between; margin-top: 0.15rem; font: 0.65rem/1.2 var(--font-mono); color: var(--muted); }

  .clip {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: calc(var(--from) * 100%);
    width: max(3px, calc(var(--span) * 100%));
    display: grid;
    place-items: center;
    border-radius: 5px;
    background: color-mix(in srgb, var(--who) 22%, var(--surface));
    border: 1.5px solid var(--who);
    transition: left 220ms var(--ease-out), width 220ms var(--ease-out), opacity 200ms;
  }
  .clip[hidden] { display: none; }
  .len { font: 600 0.7rem/1 var(--font-mono); white-space: nowrap; }
  .unreadable {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 600 0.75rem/1 var(--font-mono);
    color: var(--danger);
    background: repeating-linear-gradient(-45deg, color-mix(in srgb, var(--danger) 14%, transparent) 0 4px, transparent 4px 8px);
  }
  .unreadable[hidden] { display: none; }

  .nudges { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.5rem; }
  .nudges button { font-size: 0.75rem; padding: 0.15rem 0.5rem; }

  .fields { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 0.5rem; min-height: 1.6rem; }
  .fields :global(.field) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    border-bottom: 2px solid var(--c, var(--line));
    background: color-mix(in srgb, var(--c, var(--line)) 12%, transparent);
    font: 0.75rem/1.4 var(--font-mono);
  }
  .fields :global(.field b) { font-weight: 400; color: var(--muted); }
  .fields :global(.field.alice) { --c: var(--alice); }
  .fields :global(.field.bob) { --c: var(--bob); }
  .fields :global(.field.pending) { border-bottom-style: dashed; opacity: 0.8; }
  /* A key this version's code doesn't know: it's stored, but nothing reads it. */
  .fields :global(.field.unknown) { opacity: 0.45; text-decoration: line-through; }
  .fields :global(.field.new) { animation: pop 320ms var(--ease-out); }

  .outdated {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--danger) 12%, transparent);
    font-size: 0.8rem;
    animation: fade-in 200ms var(--ease-out);
  }
  .outdated[hidden] { display: none; }
  .outdated button { font-size: 0.75rem; padding: 0.15rem 0.6rem; }

  .queued {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 55%;
    padding: 0.05rem 0.5rem;
    border-radius: 99px;
    background: var(--who);
    color: var(--accent-fg);
    font: 600 0.72rem/1.5 var(--font-mono);
    white-space: nowrap;
  }
  .queued[hidden] { display: none; }

  .log { list-style: none; margin: 0.5rem 0 0; padding: 0; font: 0.75rem/1.5 var(--font-mono); color: var(--muted); min-height: 4.5em; }
  .log :global(li) { display: flex; gap: 0.4rem; align-items: baseline; white-space: nowrap; animation: fade-in 200ms var(--ease-out); }
  .log :global(li span) { overflow: hidden; text-overflow: ellipsis; }
  .log :global(li::before) { content: ''; flex: none; width: 0.45rem; height: 0.45rem; border-radius: 99px; background: var(--who); translate: 0 -0.05rem; }
  .log :global(li.alice) { --who: var(--alice); }
  .log :global(li.bob) { --who: var(--bob); }
  .log :global(li.changed) { color: var(--fg); }

  .latency { display: inline-flex; align-items: center; gap: 0.5rem; }
  .latency input { width: 7rem; accent-color: var(--accent); }
  .latency output { font-family: var(--font-mono); min-width: 2.5rem; }
  .status { margin-left: auto; font-weight: 600; }
  .status.ok { color: var(--success); }
  .status.bad { color: var(--danger); }

  figcaption { padding: 0 1rem 0.9rem; color: var(--muted); font-size: 0.88rem; }
  figcaption:empty { display: none; }

  .stage :global(.pill) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    offset-rotate: 0deg;
    offset-anchor: center;
    padding: 0.1rem 0.5rem;
    border-radius: 99px;
    background: var(--who);
    color: var(--accent-fg);
    font: 600 0.72rem/1.5 var(--font-mono);
    white-space: nowrap;
    pointer-events: none;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.15);
  }
  .stage :global(.pill.alice) { --who: var(--alice); }
  .stage :global(.pill.bob) { --who: var(--bob); }
  .stage :global(.pill.ack) { --who: var(--muted); font-weight: 400; }
  .stage :global(.pill small) { font-size: inherit; font-weight: 400; opacity: 0.8; }
  .stage :global(.pill .txt) { display: inline-block; }

  /* The translation layer, halfway along Alice's wire. Pills pass under it,
     and come out the other side in the other version. */
  .bridge {
    position: absolute;
    z-index: 3;
    left: var(--x, 25%);
    top: var(--y, 70%);
    translate: -50% -50%;
    display: grid;
    justify-items: center;
    gap: 0.05rem;
    padding: 0.3rem 0.7rem;
    border: 1px dashed color-mix(in srgb, var(--fg) 45%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    font: 0.68rem/1.3 var(--font-mono);
    color: var(--muted);
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 250ms, scale 250ms var(--ease-out);
    animation: fade-in 300ms var(--ease-out);
  }
  .bridge[hidden] { display: none; }
  .bridge-title { font-weight: 600; color: var(--fg); letter-spacing: 0.02em; }
  .bridge.off { opacity: 0.4; }
  .bridge.off .bridge-map { text-decoration: line-through; }

  @keyframes pop { from { transform: scale(0.6); opacity: 0; } }
  @keyframes fade-in { from { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .clip { transition: none; }
  }
  @media (max-width: 30rem) {
    .stage { gap: 6.5rem 0.6rem; padding-inline: 0.6rem; }
    .peer, .server { padding: 0.5rem; }
    .toggle span { font-size: 0.75rem; }
  }
</style>

<script>
  import { CLIENTS, TRACK, fmt, valid, type ClientId, type Clip, type Gesture } from './clip-engine';
  import { createRoom, type Message, type Mode, type LogEntry, type Room } from './migration-engine';

  const INITIAL: Clip = { in: 2, out: 9 };
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const GAP = 360;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  type Replica = ClientId | 'server';

  // Cloudflare's Worker types redeclare Element.append for HTMLRewriter, so this script sticks to
  // appendChild and insertBefore.

  function setup(root: HTMLElement) {
    const mode = root.dataset.migration as Mode;
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const serverEl = root.querySelector<HTMLElement>('.server')!;
    const log = root.querySelector<HTMLOListElement>('[data-log]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const latencyInput = root.querySelector<HTMLInputElement>('[data-latency]')!;
    const latencyOut = root.querySelector<HTMLOutputElement>('[data-latency-out]')!;
    const deployBtn = root.querySelector<HTMLButtonElement>('[data-deploy]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const bridgeInput = root.querySelector<HTMLInputElement>('[data-bridge]');
    const note = serverEl.querySelector<HTMLElement>('[data-note]')!;
    const bridgeBox = root.querySelector<HTMLElement>('[data-bridge-box]');
    const bridgeTitle = root.querySelector<HTMLElement>('[data-bridge-title]');
    /** How far along Alice's wire, from her end, the bridge sits. */
    const BRIDGE_AT = 0.5;

    const view = (el: HTMLElement) => ({
      el,
      ver: el.querySelector<HTMLElement>('[data-ver]')!,
      timeline: el.querySelector<HTMLElement>('[data-timeline]')!,
      clip: el.querySelector<HTMLElement>('[data-clip]')!,
      len: el.querySelector<HTMLElement>('[data-len]')!,
      unreadable: el.querySelector<HTMLElement>('[data-unreadable]')!,
      fields: el.querySelector<HTMLElement>('[data-fields]')!,
      seen: new Set<string>(),
    });
    const views = {
      server: view(serverEl),
      ...Object.fromEntries(CLIENTS.map((id) => [id, view(root.querySelector<HTMLElement>(`[data-peer="${id}"]`)!)])),
    } as Record<Replica, ReturnType<typeof view>>;
    const peers = Object.fromEntries(
      CLIENTS.map((id) => {
        const el = views[id].el;
        return [id, {
          online: el.querySelector<HTMLInputElement>('[data-online]')!,
          queued: el.querySelector<HTMLElement>('[data-queued]')!,
          outdated: el.querySelector<HTMLElement>('[data-outdated]')!,
          outdatedText: el.querySelector<HTMLElement>('[data-outdated-text]')!,
          reload: el.querySelector<HTMLButtonElement>('[data-reload]')!,
          nudges: [...el.querySelectorAll<HTMLButtonElement>('[data-kind]')],
          wire: root.querySelector<SVGPathElement>(`[data-wire="${id}"]`)!,
        }];
      }),
    );

    let room: Room;
    let generation = 0;
    let inFlight = 0;
    let latency = Number(latencyInput.value);

    // ---- The network: one FIFO queue per client and direction, held while offline. ----
    type Dir = 'up' | 'down';
    const queues: Record<ClientId, Record<Dir, Message[]>> = { alice: { up: [], down: [] }, bob: { up: [], down: [] } };
    let lastDepart: Record<string, number> = {};
    let lastArrival: Record<string, number> = {};
    let busy: Record<string, boolean> = {};

    function send(client: ClientId, dir: Dir, msg: Message) {
      queues[client][dir].push(msg);
      pump(client, dir);
    }

    function pump(client: ClientId, dir: Dir) {
      const key = client + dir;
      const queue = queues[client][dir];
      if (busy[key] || !peers[client].online.checked || !queue.length) return refresh();
      busy[key] = true;
      const gen = generation;
      setTimeout(() => {
        if (gen !== generation) return;
        busy[key] = false;
        if (!peers[client].online.checked || !queue.length) return refresh();
        // Snapshots replace each other, so a backlog only needs its newest; pushes all go.
        const batch = queue.splice(0);
        const msg = batch[batch.length - 1];
        const t = performance.now();
        lastDepart[key] = t;
        const arrive = Math.max(t + latency, (lastArrival[key] ?? 0) + GAP);
        lastArrival[key] = arrive;
        fly(client, dir, msg, arrive - t, batch.length);
        inFlight++;
        setTimeout(() => {
          if (gen !== generation) return;
          inFlight--;
          for (const m of batch) {
            if (dir === 'up') onServer(client, m);
            else onClient(client, m);
          }
          refresh();
        }, arrive - t);
        pump(client, dir);
      }, Math.max(0, (lastDepart[key] ?? -Infinity) + GAP - performance.now()));
      refresh();
    }

    function fly(client: ClientId, dir: Dir, msg: Message, ms: number, count: number) {
      // A message on a bridged wire is in v1 on Alice's side of the bridge and in v2 on the server's.
      const across = room.bridged(client) ? room.across(msg) : null;
      const el = document.createElement('span');
      el.className = `pill ${dir === 'down' || msg.ack ? 'ack' : client}`;
      const txt = document.createElement('span');
      txt.className = 'txt';
      txt.textContent = across && dir === 'down' && !reduceMotion.matches ? across : msg.label;
      el.appendChild(txt);
      if (count > 1) {
        const n = document.createElement('small');
        n.textContent = ` +${count - 1}`;
        el.appendChild(n);
      }
      el.style.offsetPath = `path("${peers[client].wire.getAttribute('d')}")`;
      stage.appendChild(el);
      const at = (pct: number) => `${dir === 'up' ? pct : 100 - pct}%`;
      if (across && !reduceMotion.matches) {
        // Constant speed, so the moment it reaches the bridge is easy to know.
        const when = dir === 'up' ? BRIDGE_AT : 1 - BRIDGE_AT;
        const animation = el.animate(
          [
            { offsetDistance: at(0), opacity: 0, transform: 'scale(0.8)' },
            { offsetDistance: at(6), opacity: 1, transform: 'scale(1)', offset: 0.06 },
            { offsetDistance: at(94), opacity: 1, transform: 'scale(1)', offset: 0.94 },
            { offsetDistance: at(100), opacity: 0, transform: 'scale(0.9)' },
          ],
          { duration: ms, easing: 'linear' },
        );
        animation.onfinish = animation.oncancel = () => el.remove();
        const MORPH = 360;
        setTimeout(() => {
          if (!el.isConnected) return;
          txt.animate(
            [
              { filter: 'blur(0)', opacity: 1, transform: 'scaleX(1)' },
              { filter: 'blur(4px)', opacity: 0.1, transform: 'scaleX(0.7)', offset: 0.5 },
              { filter: 'blur(0)', opacity: 1, transform: 'scaleX(1)' },
            ],
            { duration: MORPH, easing: 'ease-in-out' },
          );
          setTimeout(() => {
            if (el.isConnected) txt.textContent = dir === 'up' ? across : msg.label;
          }, MORPH / 2);
          bridgeBox?.animate([{ scale: '1' }, { scale: '1.08' }, { scale: '1' }], { duration: MORPH, easing: 'ease-out' });
        }, when * ms - MORPH / 2);
        return;
      }
      const animation = reduceMotion.matches
        ? el.animate({ offsetDistance: ['50%', '50%'], opacity: [0, 1, 1, 0] }, { duration: ms })
        : el.animate(
            [
              { offsetDistance: at(0), opacity: 0, transform: 'scale(0.8)' },
              { opacity: 1, transform: 'scale(1)', offset: 0.08 },
              { opacity: 1, transform: 'scale(1)', offset: 0.92 },
              { offsetDistance: at(100), opacity: 0, transform: 'scale(0.9)' },
            ],
            { duration: ms, easing: 'cubic-bezier(0.45, 0, 0.25, 1)' },
          );
      animation.onfinish = animation.oncancel = () => el.remove();
    }

    function addLog(entry: LogEntry) {
      const li = document.createElement('li');
      li.className = entry.by + (entry.changed ? ' changed' : '');
      const text = document.createElement('span');
      text.textContent = entry.text;
      text.title = entry.text;
      li.appendChild(text);
      log.insertBefore(li, log.firstChild);
      while (log.children.length > 3) log.lastElementChild!.remove();
    }

    function onServer(from: ClientId, msg: Message) {
      const { log: entry, out } = room.serverReceive(from, msg);
      if (entry) addLog(entry);
      render('server');
      flash(serverEl, from);
      for (const o of out) send(o.to, 'down', o.msg);
    }

    function onClient(who: ClientId, msg: Message) {
      room.clientReceive(who, msg);
      render(who);
    }

    const flashTimers = new Map<HTMLElement, number>();
    function flash(el: HTMLElement, by: ClientId) {
      el.style.setProperty('--flash', `var(--${by})`);
      el.classList.add('flash');
      clearTimeout(flashTimers.get(el));
      flashTimers.set(el, window.setTimeout(() => el.classList.remove('flash'), 700));
    }

    // ---- Drawing one copy: the clip as this copy's code reads it, and the fields it stores. ----
    function render(who: Replica) {
      const v = views[who];
      const version = who === 'server' ? room.serverVersion : room.version(who);
      v.ver.textContent = `v${version}`;
      v.ver.classList.toggle('new', version === 2);
      const c = room.clip(who);
      v.clip.hidden = !c;
      v.unreadable.hidden = !!c;
      v.timeline.classList.toggle('broken', !c || !valid(c));
      if (c) {
        v.clip.style.setProperty('--from', String(Math.min(c.in, c.out) / TRACK));
        v.clip.style.setProperty('--span', String(Math.abs(c.out - c.in) / TRACK));
        v.len.textContent = fmt(c.out - c.in);
      }
      const fields = room.fields(who);
      const keyOf = (f: (typeof fields)[number]) => `${f.key}=${f.value}${f.pending ? '?' : ''}`;
      v.fields.replaceChildren(
        ...fields.map((f) => {
          const el = document.createElement('span');
          el.className = `field ${f.by ?? ''}${f.pending ? ' pending' : ''}${f.unknown ? ' unknown' : ''}${v.seen.has(keyOf(f)) ? '' : ' new'}`;
          el.title = f.unknown
            ? `this version's code doesn't read "${f.key}"`
            : f.pending ? 'sent, not yet confirmed by the server' : f.by && f.by !== 'seed' ? `last written by ${f.by}` : 'not edited yet';
          const k = document.createElement('b');
          k.textContent = f.key;
          el.appendChild(k);
          el.appendChild(document.createTextNode(f.value));
          return el;
        }),
      );
      v.seen = new Set(fields.map(keyOf));
      if (who !== 'server') {
        const p = peers[who];
        const outdated = room.outdated(who);
        p.outdated.hidden = !outdated;
        const n = room.unsaved(who);
        p.outdatedText.textContent = n
          ? `New version out. ${n} edit${n > 1 ? 's' : ''} not saved.`
          : 'A new version is out.';
        p.nudges.forEach((b) => (b.disabled = !c));
      }
    }

    function renderAll() {
      (['alice', 'bob', 'server'] as Replica[]).forEach(render);
      note.textContent = room.serverVersion === 1
        ? 'stores + relays'
        : mode === 'reload'
          ? 'rejects v1'
          : room.bridge ? 'translates for v1' : 'no translation';
      if (bridgeBox && bridgeTitle) {
        bridgeBox.hidden = room.serverVersion !== 2;
        bridgeBox.classList.toggle('off', !room.bridge);
        bridgeTitle.textContent = room.bridge ? 'bridge' : 'bridge off';
      }
    }

    function refresh() {
      for (const id of CLIENTS) {
        const offline = !peers[id].online.checked;
        const up = queues[id].up.length;
        peers[id].queued.hidden = !offline || up === 0;
        peers[id].queued.textContent = `${up} unsent`;
        views[id].el.classList.toggle('offline', offline);
        peers[id].wire.classList.toggle('offline', offline);
      }
      deployBtn.disabled = room.serverVersion === 2;
      const pending = inFlight + CLIENTS.reduce((n, c) => n + queues[c].up.length + queues[c].down.length, 0);
      const clips = (['alice', 'bob', 'server'] as Replica[]).map((r) => room.clip(r));
      status.className = 'status';
      const bad = (text: string) => {
        status.textContent = text;
        status.classList.add('bad');
      };
      if (CLIENTS.some((c) => room.outdated(c))) bad('Alice has to reload');
      else if (pending) status.textContent = 'Syncing…';
      else if (clips.some((c) => !c)) bad("Alice can't read the document ✗");
      else if (new Set(clips.map((c) => `${c!.in}/${c!.out}`)).size !== 1) bad('Diverged ✗');
      else {
        const versions = new Set(CLIENTS.map((c) => room.version(c)));
        status.textContent = versions.size > 1 ? 'In sync, on two versions ✓' : 'In sync ✓';
        status.classList.add('ok');
      }
    }

    // ---- Local edits, deploying and reloading. ----
    function edit(who: ClientId, g: Gesture) {
      for (const m of room.gesture(who, g)) send(who, 'up', m);
      render(who);
      refresh();
    }

    function deploy() {
      if (room.serverVersion === 2) return;
      const { log: entries, out } = room.deploy();
      for (const e of [...entries].reverse()) addLog(e);
      // Bob's new tab starts clean: whatever was still in flight to his old one is gone.
      queues.bob.down = [];
      renderAll();
      for (const o of out) send(o.to, 'down', o.msg);
      refresh();
    }

    for (const id of CLIENTS) {
      const p = peers[id];
      for (const b of p.nudges) {
        b.addEventListener('click', () => edit(id, { kind: b.dataset.kind as Gesture['kind'], by: Number(b.dataset.by) }));
      }
      p.online.addEventListener('change', () => {
        pump(id, 'up');
        pump(id, 'down');
      });
      p.reload.addEventListener('click', () => {
        const dropped = room.reload(id);
        queues[id].down = [];
        addLog({ by: id, text: `Alice reloaded onto v${room.version(id)}${dropped ? `, lost ${dropped} unsaved edit${dropped > 1 ? 's' : ''}` : ''}`, changed: dropped > 0 });
        renderAll();
        refresh();
      });
    }

    function layout() {
      const box = stage.getBoundingClientRect();
      const s = serverEl.getBoundingClientRect();
      for (const id of CLIENTS) {
        const r = views[id].el.getBoundingClientRect();
        const x1 = r.left + r.width / 2 - box.left;
        const y1 = r.bottom - box.top;
        const x2 = s.left + s.width / 2 - box.left;
        const y2 = s.top - box.top;
        const my = (y1 + y2) / 2;
        peers[id].wire.setAttribute('d', `M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}`);
      }
      if (bridgeBox) {
        const wire = peers.alice.wire;
        const p = wire.getPointAtLength(wire.getTotalLength() * BRIDGE_AT);
        bridgeBox.style.setProperty('--x', `${p.x}px`);
        bridgeBox.style.setProperty('--y', `${p.y}px`);
      }
    }
    new ResizeObserver(layout).observe(stage);

    function reset() {
      generation++;
      inFlight = 0;
      room = createRoom(mode, INITIAL);
      if (bridgeInput) bridgeInput.checked = true;
      stage.querySelectorAll('.pill').forEach((p) => p.remove());
      log.replaceChildren();
      lastDepart = {};
      lastArrival = {};
      busy = {};
      for (const id of CLIENTS) {
        queues[id].up = [];
        queues[id].down = [];
        peers[id].online.checked = true;
      }
      renderAll();
      for (const r of ['alice', 'bob', 'server'] as Replica[]) {
        views[r].fields.querySelectorAll('.new').forEach((f) => f.classList.remove('new'));
      }
      playBtn.disabled = false;
      refresh();
    }

    // Alice moves the clip five seconds right while Bob trims its end four seconds left, as in part two.
    async function play() {
      reset();
      const gen = generation;
      playBtn.disabled = true;
      await wait(300);
      deploy();
      await wait(reduceMotion.matches ? 300 : latency + 700);
      if (gen !== generation) return;
      for (let i = 0; i < 5; i++) {
        edit('alice', { kind: 'move', by: 1 });
        if (i < 4) edit('bob', { kind: 'trimEnd', by: -1 });
        await wait(reduceMotion.matches ? 40 : 140);
        if (gen !== generation) return;
      }
      playBtn.disabled = false;
    }

    latencyInput.addEventListener('input', () => {
      latency = Number(latencyInput.value);
      latencyOut.value = `${(latency / 1000).toFixed(1)}s`;
    });
    bridgeInput?.addEventListener('change', () => {
      for (const o of room.setBridge(bridgeInput.checked)) send(o.to, 'down', o.msg);
      renderAll();
      refresh();
    });
    deployBtn.addEventListener('click', deploy);
    playBtn.addEventListener('click', play);
    root.querySelector('[data-reset]')!.addEventListener('click', reset);

    reset();
    layout();
  }

  document.querySelectorAll<HTMLElement>('[data-migration]').forEach(setup);
</script>
