---
// Where this post sits in the sync engine series. Parts that aren't written yet are listed
// without a link.
import { getPosts } from '../lib/posts';
import { SYNC_SERIES } from '../lib/series';

interface Props {
  current: string;
}

const { current } = Astro.props;
const published = new Set((await getPosts()).map((p) => p.id));
const index = SYNC_SERIES.parts.findIndex((p) => p.slug === current);
---

<nav class="series" aria-label={`${SYNC_SERIES.name} series`}>
  <p class="label">
    {SYNC_SERIES.name} · part {index + 1} of {SYNC_SERIES.parts.length}
  </p>
  <ol>
    {SYNC_SERIES.parts.map((part, i) => (
      <li>
        {part.slug === current ? (
          <span class="row current" aria-current="page">
            <span class="num">{i + 1}.</span> {part.title}
          </span>
        ) : published.has(part.slug) ? (
          <a class="row" href={`/blog/${part.slug}/`}>
            <span class="num">{i + 1}.</span> <span class="title">{part.title}</span>
          </a>
        ) : (
          <span class="row soon">
            <span class="num">{i + 1}.</span> {part.title} · coming soon
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .series {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .label { margin: 0 0 0.5rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  /* The numbers live inside each row (not as list markers) so a linked part is a link
     number and all. The <ol> still gives screen readers the list position. */
  ol { margin: 0; padding: 0; list-style: none; }
  li { padding: 0.1rem 0; }
  /* The hanging indent lines a wrapped title up under the title (all parts are 1–9). */
  .row { display: block; padding-left: 1.2em; text-indent: -1.2em; }
  .num { font-variant-numeric: tabular-nums; }
  /* A linked part is red number and all, but only the title is underlined. */
  a.row { text-decoration: none; }
  a.row .title { text-decoration: underline; text-underline-offset: 0.2em; }
  a.row:hover .title { text-decoration-thickness: 2px; }
  .current { font-weight: 600; }
  .soon { color: var(--muted); }
</style>
