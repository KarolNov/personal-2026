---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A screenshot as wide as the videos and playgrounds, with an optional caption in the slot.
interface Props {
  src: ImageMetadata;
  alt: string;
}
const { src, alt } = Astro.props;
---

<figure class="figure">
  <a href={src.src} aria-label={`${alt} (full size)`}>
    <Image src={src} alt={alt} widths={[640, 960, 1600]} sizes="(min-width: 52rem) 50rem, 100vw" />
  </a>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .figure {
    --w: min(50rem, 100vw - 2.5rem);
    width: var(--w);
    margin: 2.25rem calc((100% - var(--w)) / 2);
  }
  a { display: block; }
  a :global(img) {
    display: block;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
  }
  figcaption { margin-top: 0.6rem; color: var(--muted); font-size: 0.88rem; }
  figcaption:empty { display: none; }
</style>
