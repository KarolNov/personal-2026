---
// A video with its own captions track, as wide as the playgrounds. Captions start on, since most people
// scroll past with the sound off, and the player's menu turns them off.

interface Props {
  src: string;
  poster: string;
  captions: string;
  /** What the video shows, for screen readers. */
  label: string;
}
const { src, poster, captions, label } = Astro.props;
---

<figure class="video">
  <video controls playsinline preload="metadata" poster={poster} aria-label={label}>
    <source src={src} type="video/mp4" />
    <track kind="captions" srclang="en" label="English" src={captions} default />
  </video>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .video {
    /* Wider than the text column where there's room, never wider than the screen. */
    --w: min(50rem, 100vw - 2.5rem);
    width: var(--w);
    margin: 2.25rem calc((100% - var(--w)) / 2);
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 1280 / 800;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
  }
  figcaption { margin-top: 0.6rem; color: var(--muted); font-size: 0.88rem; }
  figcaption:empty { display: none; }
</style>
