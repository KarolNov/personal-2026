---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="muted">No posts yet.</p>
) : (
  <ul>
    {posts.map((post) => (
      <li>
        <time class="muted" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <div>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          <p class="muted">{post.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; }
  li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; }
  time { font-size: 0.9rem; font-variant-numeric: tabular-nums; padding-top: 0.1rem; }
  a { font-weight: 600; text-decoration: none; color: var(--fg); }
  a:hover { color: var(--accent); }
  p { margin: 0.2rem 0 0; font-size: 0.95rem; }
  @media (max-width: 30rem) {
    li { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
